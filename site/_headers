/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
/assets/*
  Cache-Control: public, max-age=86400
/assets/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/og.png
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon-32.png
  Cache-Control: public, max-age=604800
/favicon-180.png
  Cache-Control: public, max-age=604800
/style.css
  Cache-Control: public, max-age=3600, must-revalidate
/fonts.css
  Cache-Control: public, max-age=86400
/present
  ! Permissions-Policy
  Permissions-Policy: geolocation=(), payment=(), usb=()
/present.html
  ! Permissions-Policy
  Permissions-Policy: geolocation=(), payment=(), usb=()
/
  Link: </.well-known/ai-catalog.json>; rel="ai-catalog"; type="application/ai-catalog+json", </llms.txt>; rel="alternate"; type="text/plain"
/.well-known/ai-catalog.json
  ! Content-Type
  Content-Type: application/ai-catalog+json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
/llms.txt
  Access-Control-Allow-Origin: *
